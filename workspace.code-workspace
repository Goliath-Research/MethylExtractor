{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C Program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main",
            "args": [
                "--hdf5-output-dir", "output", 
                "--hdf5-compression", "6", 
                "--hdf5-chunk-size", "100000", 
                "--threads", "4", 
                "Homo_sapiens.GRCh38.dna.primary_assembly.fa", 
                "sorted_alignments.bam"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "launch": {
        "version": "0.2.0",
        "configurations": []
    },
    "folders": [
        {
            "path": "."
        }
    ]
}