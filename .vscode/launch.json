        "--hdf5-compression", "9", 
        "--q", "30", 
        "--p", "20", 
        "--CHG", 
        "--CHH", 
        "--c", "4",
        "--C", "100",
        "--gpu"
        "/home/ubuntu/Work/genomes/human_genome/release-113/Homo_sapiens.GRCh38.dna.primary_assembly.fa", 
        "/home/ubuntu/Work/HRA006113/HRR1458908/HRR1458908.bam"
      ],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/ubuntu/MethylExtractor/build/dynamic",
      "program": "/home/ubuntu/MethylExtractor/build/dynamic/MethylExtractor",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
