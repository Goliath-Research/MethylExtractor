      "request": "launch",
      "args": [
        "-x", "/home/ubuntu/Work/HRA006113/human2014.json",
        "-O", "/home/ubuntu/Work/HRA006113/HRR1458910", 
        "-z", "9", 
        "-q", "30", 
        "-p", "20", 
        "-G", 
        "-H", 
        "-c", "0",
        "-k", "1000000",
        "-S",
        "/home/ubuntu/Work/genomes/human_genome/release-113/Homo_sapiens.GRCh38.dna.primary_assembly.fa", 
        "/home/ubuntu/Work/HRA006113/HRR1458910/HRR1458910.bam"
      ],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/ubuntu/MethylExtractor/build/debug",
      "program": "/home/ubuntu/MethylExtractor/build/debug/MethylExtractor",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
