{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make dynamic",
            "type": "shell",
            "command": "make dynamic",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build MethylExtractor (release, dynamic linking)"
        },
        {
            "label": "make debug",
            "type": "shell",
            "command": "make debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build MethylExtractor with debug symbols"
        },
        {
            "label": "make clean",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Remove build artifacts"
        }
    ]
}
